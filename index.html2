<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Five Star Coffee · Menú</title>
<style>
:root{--bg:#f6efe6;--card:#ffffff;--tx:#231815;--mu:#6f625a;--ac:#c4161c;--ac2:#9f1015;--bd:#e5d9cc;--navy:#1f2a44;--rd:#c4161c}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
.wrap{max-width:860px;margin:0 auto;padding:0 20px 60px}
.top{display:flex;align-items:center;justify-content:space-between;padding:14px 0}
.logo{height:64px;width:auto;display:block}
.hero{background:var(--ac);color:#fff;border-radius:18px;padding:40px 28px 36px;margin-bottom:32px;position:relative;overflow:hidden}
.hero:after{content:"★ ★ ★ ★ ★";position:absolute;right:22px;bottom:16px;color:rgba(255,255,255,.35);letter-spacing:.3em;font-size:14px}
.eyebrow{font-size:14px;opacity:.85}
h1{font:600 clamp(36px,7vw,58px)/1.05 Georgia,serif;margin:8px 0 10px}
.hero p{margin:0;max-width:46ch;opacity:.92}
h2{font:600 24px Georgia,serif;color:var(--ac);margin:36px 0 12px;padding-bottom:8px;border-bottom:2px solid var(--ac)}
.item{display:flex;justify-content:space-between;gap:16px;padding:14px 0;border-bottom:1px dashed var(--bd)}
.item h3{margin:0;font-size:17px;color:var(--navy)}.item p{margin:2px 0 0;color:var(--mu);font-size:14px}
.price{color:var(--ac);font-weight:700;white-space:nowrap}
.off{opacity:.5}.tag{font-size:11px;color:var(--rd);border:1px solid var(--rd);border-radius:99px;padding:1px 8px;margin-left:8px}
#st,.empty{color:var(--mu);text-align:center;padding:24px 0}
.bar{display:flex;justify-content:space-between;align-items:center;gap:12px;background:var(--navy);color:#fff;border-radius:12px;padding:12px 16px;margin-bottom:20px}
button{font:inherit;cursor:pointer;border-radius:8px;border:1px solid var(--bd);background:var(--card);color:var(--tx);padding:7px 14px}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--navy);outline-offset:2px}
button.pri{background:var(--ac);color:#fff;border-color:var(--ac);font-weight:600}
button.pri:hover{background:var(--ac2)}
button.del{color:var(--rd);border-color:var(--rd)}
.acts{display:flex;gap:6px;margin-top:8px}.acts button{padding:3px 10px;font-size:13px}
form{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:16px;display:grid;gap:10px;margin-bottom:24px}
[hidden]{display:none!important}
input,select,textarea{font:inherit;width:100%;background:var(--bg);color:var(--tx);border:1px solid var(--bd);border-radius:8px;padding:8px 10px}
.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
label{font-size:13px;color:var(--mu);display:grid;gap:4px}
label.ck{display:flex;align-items:center;gap:8px;color:var(--tx)}label.ck input{width:auto}
footer{color:var(--mu);font-size:13px;text-align:center;padding-top:40px}
footer button{background:none;border:none;color:var(--mu);text-decoration:underline;padding:0}
#err{color:var(--rd);font-size:14px}
</style>
</head>
<body>
<div class="wrap">
<div class="top"><img class="logo" alt="Five Star Coffee Roasters" src="data:image/png;base64,"></div>
<header class="hero">
  <div class="eyebrow">Cafetería · Tostado artesanal</div>
  <h1>Five Star Coffee</h1>
  <p>Café de especialidad, postres hechos cada mañana y un rincón tranquilo para quedarte.</p>
</header>

<div class="bar" id="adminbar" hidden>
  <span>Modo administrador</span>
  <span><button class="pri" id="newbtn">+ Nuevo plato</button> <button id="seedbtn">Cargar menú completo</button> <button id="logout">Salir</button></span>
</div>

<form id="login" hidden>
  <label>Correo<input id="l-mail" type="email" required autocomplete="username"></label>
  <label>Contraseña<input id="l-pass" type="password" required autocomplete="current-password"></label>
  <div id="err"></div>
  <div class="acts"><button class="pri" type="submit">Entrar</button><button type="button" id="l-cancel">Cancelar</button></div>
</form>

<form id="form" hidden>
  <div class="row">
    <label>Nombre<input id="f-name" required maxlength="60"></label>
    <label>Precio (L)<input id="f-price" type="number" step="0.01" min="0" required></label>
  </div>
  <label>Descripción<textarea id="f-desc" rows="2" maxlength="160"></textarea></label>
  <div class="row">
    <label>Categoría<select id="f-cat"></select></label>
    <label class="ck"><input id="f-ok" type="checkbox" checked> Disponible hoy</label>
  </div>
  <div class="acts"><button class="pri" type="submit">Guardar</button><button type="button" id="cancel">Cancelar</button></div>
</form>

<div id="st">Cargando menú…</div>
<main id="menu"></main>
<footer>Menú de demostración · Los precios pueden cambiar<br><br><button id="adminlink">Acceso administrador</button></footer>
</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.js"></script>
<script>
// 1) Pega aquí los datos de tu proyecto (Supabase > Project Settings > API).
//    La "anon key" es pública por diseño: la seguridad la dan las reglas del schema.sql.
var SUPABASE_URL='https://joupmggamcrobxcumaab.supabase.co';
var SUPABASE_ANON_KEY='eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpvdXBtZ2dhbWNyb2J4Y3VtYWFiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTUxMjI5MTMsImV4cCI6MjExMDY5ODkxM30.dr1pgE2hNC-psHMGpE8V_Irorr_q3xHTIkfixtj9yBE';

var sb=supabase.createClient(SUPABASE_URL,SUPABASE_ANON_KEY);
var CATS=['Bebidas calientes','Bebidas frías con café','Bebidas frías naturales','Dulces','Salados','Postres'];
function D(c,n,p,d){return{category:c,name:n,price:p,description:d||'',available:true}}
var DEFAULTS=[
D('Bebidas calientes','Americano 8 oz',45),D('Bebidas calientes','Americano 12 oz',55),
D('Bebidas calientes','Capuchino 8 oz',55),D('Bebidas calientes','Capuchino 12 oz',65),
D('Bebidas calientes','Latté 8 oz',58),D('Bebidas calientes','Latté 12 oz',68),
D('Bebidas calientes','Chai latté 8 oz',68),D('Bebidas calientes','Chai latté 12 oz',78),
D('Bebidas calientes','Chocolate 8 oz',57),D('Bebidas calientes','Chocolate 12 oz',70),
D('Bebidas calientes','Espresso Boom',80),D('Bebidas calientes','Macchiato',65),
D('Bebidas calientes','Mocca 8 oz',65),D('Bebidas calientes','Mocca 12 oz',75),
D('Bebidas calientes','Espresso 8 oz',40),D('Bebidas calientes','Espresso 12 oz',65),
D('Bebidas calientes','Matcha 8 oz',75),D('Bebidas calientes','Matcha 12 oz',98),
D('Bebidas frías con café','Frozen de café',80,'12 oz'),D('Bebidas frías con café','Frozen de café & Oreo',85,'12 oz'),
D('Bebidas frías con café','Frozen Five Star',90,'12 oz'),D('Bebidas frías con café','Iced coffee',80,'12 oz'),
D('Bebidas frías con café','Iced latté',80,'12 oz'),D('Bebidas frías con café','Mocca frío',85,'12 oz'),
D('Bebidas frías naturales','Frozen de arándanos',95,'12 oz'),D('Bebidas frías naturales','Frozen de piña',95,'12 oz'),
D('Bebidas frías naturales','Frozen de fresa',95,'12 oz'),D('Bebidas frías naturales','Frozen de menta limón',75,'12 oz'),
D('Bebidas frías naturales','Frozen de limón',70,'12 oz'),D('Bebidas frías naturales','Frozen de maracuyá',90,'12 oz'),
D('Bebidas frías naturales','Frozen de banano',80,'12 oz'),D('Bebidas frías naturales','Limonada líquida',60,'12 oz'),
D('Bebidas frías naturales','Frozen tropical',95,'12 oz'),D('Bebidas frías naturales','Frozen de mango',85,'12 oz'),
D('Bebidas frías naturales','Frozen de tamarindo',80,'12 oz'),D('Bebidas frías naturales','Té frío',75,'12 oz'),
D('Bebidas frías naturales','Frozen de sandía',90,'12 oz'),D('Bebidas frías naturales','Frozen de sandía y limón',95,'12 oz'),
D('Bebidas frías naturales','Frozen chai',98,'12 oz'),D('Bebidas frías naturales','Frozen matcha',115,'12 oz'),
D('Bebidas frías naturales','Frozen horchata',80,'12 oz'),D('Bebidas frías naturales','Frozen de chocolate',85,'12 oz'),
D('Dulces','Crepa con queso crema y nutella',105),D('Dulces','Waffle',85),D('Dulces','Waffle de Oreo',105),
D('Dulces','Waffle con frutas',95),D('Dulces','Panqueques',85),
D('Salados','Croissant de jamón y queso',80),D('Salados','Panini de pollo',95),D('Salados','Panini de jamón',80),
D('Salados','Pan con frijoles',40),D('Salados','Pan con frijoles y huevo',50),D('Salados','Empanada de pollo',50)
];
var items=[],isAdmin=false,editId=null;
function $(s){return document.querySelector(s)}
function el(t,c,x){var e=document.createElement(t);if(c)e.className=c;if(x!=null)e.textContent=x;return e}
function fillCats(){var s=$('#f-cat');s.textContent='';CATS.forEach(function(c){var o=el('option',null,c);o.value=c;s.appendChild(o)})}
fillCats();

function render(){
  var m=$('#menu');m.textContent='';
  var cats=CATS.slice();
  items.forEach(function(i){if(cats.indexOf(i.category)<0)cats.push(i.category)});
  cats.forEach(function(cat){
    var g=items.filter(function(i){return i.category===cat});
    if(!g.length&&cat!=='Postres')return;
    m.appendChild(el('h2',null,cat));
    if(!g.length){m.appendChild(el('div','empty','Consulta por nuestros postres del día.'));return}
    g.forEach(function(i){
      var row=el('div','item'+(i.available?'':' off'));
      var l=el('div'),h=el('h3',null,i.name);
      if(!i.available)h.appendChild(el('span','tag','Agotado'));
      l.appendChild(h);if(i.description)l.appendChild(el('p',null,i.description));
      if(isAdmin&&i.id){
        var a=el('div','acts'),e=el('button',null,'Editar'),d=el('button','del','Eliminar');
        e.onclick=function(){openForm(i)};d.onclick=function(){removeItem(i)};
        a.appendChild(e);a.appendChild(d);l.appendChild(a);
      }
      row.appendChild(l);row.appendChild(el('div','price','L '+Number(i.price).toFixed(2)));
      m.appendChild(row);
    });
  });
}

async function load(){
  var r=await sb.from('menu_items').select('*').order('name');
  $('#st').textContent='';
  var db=r.data||[];
  var known=db.filter(function(i){return CATS.indexOf(i.category)>=0});
  items=(r.error||!known.length)?DEFAULTS:db;
  render();
}

async function seedMenu(){
  if(!confirm('¿Agregar el menú completo a la base de datos? Los platos que ya existan con el mismo nombre se omiten.'))return;
  var r=await sb.from('menu_items').select('name');
  var have=(r.data||[]).map(function(x){return x.name.toLowerCase()});
  var add=DEFAULTS.filter(function(d){return have.indexOf(d.name.toLowerCase())<0});
  if(add.length){
    var w=await sb.from('menu_items').insert(add);
    if(w.error){alert('No se pudo cargar el menú. Revisa los permisos de la tabla.');return}
  }
  load();
}
$('#seedbtn').onclick=seedMenu;

async function checkAdmin(){
  var s=await sb.auth.getSession();
  isAdmin=false;
  if(s.data.session){
    var r=await sb.from('admins').select('user_id').maybeSingle();
    isAdmin=!!(r.data);
  }
  $('#adminbar').hidden=!isAdmin;
  $('#adminlink').hidden=isAdmin;
  await load();
}

function openForm(i){
  editId=i?i.id:null;
  $('#f-name').value=i?i.name:'';$('#f-price').value=i?i.price:'';
  $('#f-desc').value=i?(i.description||''):'';$('#f-cat').value=i?i.category:CATS[0];
  $('#f-ok').checked=i?i.available:true;
  $('#form').hidden=false;$('#f-name').focus();
}
function closeForm(){$('#form').hidden=true;editId=null}

async function removeItem(i){
  if(!confirm('¿Eliminar “'+i.name+'”?'))return;
  var r=await sb.from('menu_items').delete().eq('id',i.id);
  if(r.error)alert('No se pudo eliminar.');else load();
}

$('#newbtn').onclick=function(){openForm(null)};
$('#cancel').onclick=closeForm;
$('#form').onsubmit=async function(ev){
  ev.preventDefault();
  var d={name:$('#f-name').value.trim(),price:parseFloat($('#f-price').value)||0,description:$('#f-desc').value.trim(),category:$('#f-cat').value,available:$('#f-ok').checked};
  var r=editId?await sb.from('menu_items').update(d).eq('id',editId):await sb.from('menu_items').insert(d);
  if(r.error){alert('No se pudo guardar.');return}
  closeForm();load();
};

$('#adminlink').onclick=function(){$('#login').hidden=false;$('#l-mail').focus()};
$('#l-cancel').onclick=function(){$('#login').hidden=true};
$('#login').onsubmit=async function(ev){
  ev.preventDefault();$('#err').textContent='';
  var r=await sb.auth.signInWithPassword({email:$('#l-mail').value,password:$('#l-pass').value});
  if(r.error){$('#err').textContent='Correo o contraseña incorrectos.';return}
  $('#login').hidden=true;$('#l-pass').value='';checkAdmin();
};
$('#logout').onclick=async function(){await sb.auth.signOut();closeForm();checkAdmin()};

checkAdmin();
</script>
</body>
</html>
